{"version":3,"kind":"Article","sha256":"cb6b8f5a2cf0d83b8c720d17d69d237682b1d8889f40e4e804ad01a1cc2978b3","slug":"book.premiwsurvey","location":"/book/PreMIWSurvey.md","dependencies":[],"frontmatter":{"title":"Survey Results","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Ada Carter & Katie Bigham","given":"Ada Carter & Katie","family":"Bigham"},"name":"Ada Carter & Katie Bigham","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/ada-carter/cv","copyright":"2025","numbering":{"title":{"offset":1}},"source_url":"https://github.com/ada-carter/cv/blob/main/book/PreMIWSurvey.md","edit_url":"https://github.com/ada-carter/cv/edit/main/book/PreMIWSurvey.md","thumbnail":"/build/grad_undergrad_break-0f7f7fffc90c6f980f1a3fc4dbdaa9c7.png","exports":[{"format":"md","filename":"PreMIWSurvey.md","url":"/build/PreMIWSurvey-56646c62edb0c957c7a4537206d95102.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"zX9fGl5ZPK"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"lkII5UyvCS"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"This textbook and its associated course are part of an active research effort aimed at describing and understanding the current state of marine computer vision (CV) knowledge and education. To gain deeper insights into the knowledge levels and interests of students in this field, we surveyed the University of Washington’s (UW) marine science student body. This report presents the findings from that survey and provides a clearer understanding of how familiar students are with marine imagery and computer vision.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"AkPTo2GC3V"}],"key":"pYVQIAxmEa"},{"type":"thematicBreak","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"yzL5rHPDda"},{"type":"heading","depth":2,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Survey Methodology","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"U2AQGpkg2L"}],"identifier":"survey-methodology","label":"Survey Methodology","html_id":"survey-methodology","implicit":true,"key":"xxZUdhdRxH"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"An interest form was exclusively distributed to marine science undergraduate and graduate students at the University of Washington.\nThe form gathered information about their major/department affiliation, student status (graduate or undergraduate),\nknowledge of marine imagery, and familiarity and interest in computer vision as it relates to marine imagery.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"seRpXQiiWI"}],"key":"XKWsrFXhKE"},{"type":"heading","depth":3,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Survey Goals","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"kstiS0qgeK"}],"identifier":"survey-goals","label":"Survey Goals","html_id":"survey-goals","implicit":true,"key":"jYgCvixjqL"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"The survey aimed to accomplish the following:","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"hDMPJz85Dl"}],"key":"rF1sCWlreB"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":19,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Understand familiarity","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"b06GaCsWB8"}],"key":"PEt1leo0OO"},{"type":"text","value":": Determine how well students are acquainted with marine imagery data collection at UW and other scientific institutions.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"cqH0QxCZkd"}],"key":"kb7X6RW6n7"}],"key":"GYeofxMBAl"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Assess technical knowledge","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"UeAixrKrfC"}],"key":"TQcwkmKEzR"},{"type":"text","value":": Evaluate students’ self-reported knowledge of computer vision techniques.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"AiRklTOYHc"}],"key":"BZe3qdYGJN"}],"key":"vo33WHSGGU"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Gauge interest","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"qjnnFn465T"}],"key":"WC1ESa9SYZ"},{"type":"text","value":": Identify the level of interest in applying computer vision to marine imagery and the possibility of offering a dedicated course on this topic.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"WBF16ePWSH"}],"key":"d2E9jiGvdj"}