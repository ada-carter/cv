y","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"S3MTciGso1","urlSource":"images/familiarity_marine_imagery.png"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"The histogram shows how familiar respondents are with marine imagery data collection, with ratings ranging from 1 to 10.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"yQboQNLvqG"}],"key":"tpSHHhdf2O"},{"type":"image","url":"/build/knowledge_python_pro-ebf0e5cc0de519c4a6aec2cf3a20f40d.png","alt":"Knowledge of the Python Programming Language","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"fGwF5EMS9k","urlSource":"images/knowledge_python_programming.png"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"This histogram represents the self-reported knowledge of computer vision rated from 1 to 10.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"Fi69J4P2Kd"}],"key":"fksN89HFWF"},{"type":"image","url":"/build/pythoninsight-928496cd51db9b97f584ed61f0808eec.png","alt":"Insights by Major and Status","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"UQd1vP0g5d","urlSource":"images/pythoninsight.png"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"In addition to visualizing Python knowledge across all respondents, further analysis was conducted to compare Python skills by major and between undergraduate and graduate students. The bar graph above shows that students from Marine Biology, Oceanography, and Aquatic and Fisheries Sciences reported varying levels of Python proficiency, with Marine Biology having the highest number of respondents but relatively low Python knowledge on average.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"BuP633s5PS"}],"key":"xnZVywgq2r"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Graduate students tended to report higher Python proficiency compared to undergraduates, though both groups showed a wide range of experience.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"a7OZQ4WAKt"}],"key":"RSlitNJ2tw"},{"type":"image","url":"/build/knowledge_computer_v-fe4765f20816038d8c03086a0fda1b98.png","alt":"Knowledge of Computer Vision","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"MyOqipqzHJ","urlSource":"images/knowledge_computer_vision.png"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"This histogram represents the self-reported knowledge of computer vision, providing insights into the technical background\nof the respondents.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"RUOWL9PpSl"}],"key":"yVO3CL7hhS"},{"type":"image","url":"/build/interest_marine_cv_c-9a4d8ba620f6d7c83e9c4543a39486a0.png","alt":"Interest in Taking Marine CV Course","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"JjCyDVyc2h","urlSource":"images/interest_marine_cv_course.png"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"The final histogram presents respondents’ interest in enrolling in a marine computer vision course, rated from 1 to 10.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"DiRyGbAcpm"}],"key":"aHrB1HYo5V"},{"type":"heading","depth":2,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Statistical Analysis: Interest in Marine CV Course and Knowledge in Python and Computer Vision","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"DZKu1nitM4"}],"identifier":"statistical-analysis-interest-in-marine-cv-course-and-knowledge-in-python-and-computer-vision","label":"Statistical Analysis: Interest in Marine CV Course and Knowledge in Python and Computer Vision","html_id":"statistical-analysis-interest-in-marine-cv-course-and-knowledge-in-python-and-computer-vision","implicit":true,"key":"LfLhHTmsBq"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"To further investigate the relationship between students’ interest in taking a Marine CV course and their knowledge of Computer Vision and Python, we performed a comparison between two groups: those with high interest (rating > 7) and those with lower interest (rating ≤ 7).","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"vTSEpIcAtx"}],"key":"Sb0eaBUrrk"},{"type":"image","url":"/build/interestgreater-a022bd400159cf4c3ae3de6c92bb87c0.png","alt":"Average Knowledge Compared to Interest","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"LLPxF6eJ3W","urlSource":"images/interestgreater.png"},{"type":"heading","depth":3,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Statistical Significance","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"dCJhtISKaJ"}],"identifier":"statistical-significance","label":"Statistical Significance","html_id":"statistical-significance","implicit":true,"key":"CHaAV0LEip"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":85,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Computer Vision Knowledge","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"Br64tqHeav"}],"key":"R8cTwGEREZ"},{"type":"text","value":": A t-test comparing the knowledge of Computer Vision between the two groups resulted in a p-value of 0.053. Although students with higher interest showed greater knowledge in Computer Vision, this difference is not statistically significant at the 95% confidence level.","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"paNsUqClGy"}],"key":"bECnAtr06V"}],"key":"ny38HgiP0t"},{"type":"listItem","spread":true,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Python Programming Knowledge","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"XZ7YBr5Efk"}],"key":"bc2FppWyf3"},{"type":"text","value":": The t-test for Python knowledge yielded a p-value of 0.007, indicating a statistically significant difference. Students with greater interest in the Marine CV course had significantly higher knowledge of Python compared to those with lower interest.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"fVQqp9OlBr"}],"key":"QSLDD6aB5Q"}],"key":"duvE4r1LR9"}],"key":"roivQgoqQA"},{"type":"thematicBreak","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"S3cEjUm1G3"},{"type":"heading","depth":2,"position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"Interpretation of the Data","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"tHxsyeAPgy"}],"identifier":"interpretation-of-the-data","label":"Interpretation of the Data","html_id":"interpretation-of-the-data","implicit":true,"key":"xbxkxwzHfc"},{"type":"paragraph","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"From the data, it is clear that while there is moderate interest in applying computer vision to marine imagery, the overall knowledge of computer vision and programming, particularly in Python, remains relatively low. This justifies the need for this textbook and its associated course, which aims to bridge the gap in technical knowledge and introduce these powerful tools in marine science.","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"q2uWNA5NqI"}],"key":"Xt4swtO4So"},{"type":"heading","depth":3,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Missing Subset of Students","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"xMfrRIhsrc"}],"identifier":"missing-subset-of-students","label":"Missing Subset of Students","html_id":"missing-subset-of-students","implicit":true,"key":"RYTtvsxAv4"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"These results also highlight an important consideration: we may be missing a subset of students who are interested in Marine CV but feel intimidated by the programming requirements, particularly Python. The low level of Python knowledge among many respondents suggests that there may be a barrier to entry for students who would otherwise be eager to engage with computer vision in marine science but lack the necessary programming background.","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"wrqL53gjVD"}],"key":"oFITLjYtTG"},{"type":"paragraph","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"text","value":"This further justifies the inclusion of detailed descriptions and step-by-step explanations for each process in the textbook, ensuring that students from diverse backgrounds can successfully engage with and apply computer vision techniques to their work in marine imagery. By providing accessible and comprehensive materials, the course and textbook will serve as foundational resources for increasing the technical competence of students and preparing them for further advanced studies or professional applications of computer vision in marine science.","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"ceTv6JROKy"}],"key":"QQkJBmoTEG"}],"key":"WXvgtg1TXp"}],"key":"DyAVszqcCQ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Bibliography","url":"/book/bibliography","group":"Appendices"},"next":{"title":"A.3 The Math Behind Convolutional Neural Networks (CNNs)","url":"/book/introduction-cnn","group":"Appendices"}}},"domain":"http://localhost:3000"}