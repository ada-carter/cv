{"version":3,"kind":"Article","sha256":"3390760ef65d64705c8d81adb52f8343895563d9e73d8ecf944d6ba293127b6b","slug":"book.introduction-ai","location":"/book/Introduction_AI.md","dependencies":[],"frontmatter":{"title":"1.4 Introduction AI","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Ada Carter & Katie Bigham","given":"Ada Carter & Katie","family":"Bigham"},"name":"Ada Carter & Katie Bigham","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/ada-carter/cv","copyright":"2025","numbering":{"title":{"offset":1}},"source_url":"https://github.com/ada-carter/cv/blob/main/book/Introduction_AI.md","edit_url":"https://github.com/ada-carter/cv/edit/main/book/Introduction_AI.md","thumbnail":"/build/AI_subfields-940ab402416236ac8634bfd26322621b.png","exports":[{"format":"md","filename":"Introduction_AI.md","url":"/build/Introduction_AI-b30c1f53a8d0accb1e184ae157562616.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fvIrlqOyVt"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"A non-comprehensive review of AI","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"f9U8zUk5Ie"}],"identifier":"a-non-comprehensive-review-of-ai","label":"A non-comprehensive review of AI","html_id":"a-non-comprehensive-review-of-ai","implicit":true,"key":"Vo1OWT17CD"},{"type":"heading","depth":3,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"What is Artificial Intelligence (AI)","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"CW47HU9AhR"}],"identifier":"what-is-artificial-intelligence-ai","label":"What is Artificial Intelligence (AI)","html_id":"what-is-artificial-intelligence-ai","implicit":true,"key":"hAwBnJy3y8"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Artificial Intelligence (AI) is a broad field with the goal of developing computers and robots that can mimic and go beyond human capabilities. Some examples of these capabilities include recognizing objects or sound, understanding natural language, and solving complex problems. AI is often used interchangeably with the term machine learning (ML) and many AI advancements are underpinned by ML, but ML is one of several subdomains. Examples of other subdomains include deep learning, robotics, neural networks, and natural language processing. These subdomains are not mutually exclusive and can be used in combination with one another or even in some cases be considered subfields of one another. For example, deep learning is a subfield of machine learning.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"KegnV3E5z8"}],"key":"zqsvaQorbT"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/AI_subfields-940ab402416236ac8634bfd26322621b.png","key":"kIEZRhWWej","urlSource":"images/AI_subfields.png"}],"label":"AI_intro_fig","identifier":"ai_intro_fig","enumerator":"1","html_id":"ai-intro-fig","key":"JYOqcfLdTD"},{"type":"heading","depth":3,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"What is Machine Learning (ML)?","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"GWMfpyg0VP"}],"identifier":"what-is-machine-learning-ml","label":"What is Machine Learning (ML)?","html_id":"what-is-machine-learning-ml","implicit":true,"key":"swbeLBLaud"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Machine learning (ML) is a subset of AI where an algorithm or a set of algorithms learn from the environment. Instead of being explicitly programmed for a task, the algorithm or model is able to learn to solve a task by analyzing data, learning from experience, and making inferences. Ideally, ML algorithms improve over time as they are exposed to more data, however the quality of the data and the objective of the model can impact the overall quality - even when large quantities of data are available.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"GhSgQk7Z09"}],"key":"JzGD3ErSvJ"},{"type":"admonition","kind":"seealso","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"See Also","key":"UL5ZB7KnEi"}],"key":"hMZkwI7jJi"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"If you are interested in learning more about Machine Learning, Google provides several foundational and advance courses as well as guides and a glossary that are a good starting point ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"CuoyWeL8Z4"},{"type":"link","url":"https://developers.google.com/machine-learning/foundational-courses","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"https://​developers​.google​.com​/machine​-learning​/foundational​-courses","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"bNxBFQrRKv"}],"urlSource":"https://developers.google.com/machine-learning/foundational-courses","key":"QrWzOljhhK"}],"key":"IA8RYPzh8r"}],"key":"wAcyBsdLQm"},{"type":"heading","depth":4,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Supervised vs Unsupervised Learning","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"dys6b4zqJk"}],"identifier":"supervised-vs-unsupervised-learning","label":"Supervised vs Unsupervised Learning","html_id":"supervised-vs-unsupervised-learning","implicit":true,"key":"rlnjsB8Uxa"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Machine learning can often be divided between supervised and unsupervised approaches. Supervised systems are given input data and their corresponding output (measurements or labels assigned by experts; the “correct” answer). These systems learn and map connections between the input and the output (correct answers) until they are able to apply these connections to unseen data. Unsupervised systems are only given input data and search for patterns, the goal for these systems is to identify meaningful patterns. A common use of unsupervised methods is to cluster data points or conversely identify outliers.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"zDlAYTuZPl"}],"key":"QyEsO7G91R"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"This course will primarily focus on supervised methods.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"VRLhncDiEp"}],"key":"nSgzKf5gZg"},{"type":"heading","depth":4,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"What is Deep Learning and Neural Networks?","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"xws7DWgPvI"}],"identifier":"what-is-deep-learning-and-neural-networks","label":"What is Deep Learning and Neural Networks?","html_id":"what-is-deep-learning-and-neural-networks","implicit":true,"key":"uCkCTYWFQF"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Deep learning (DL) is a subfield of machine learning. The difference between deep learning and traditional machine learning is the structure of the underlying neural network. Traditional ML models have simple neural networks with one or two computational layers, while DL models have more than the three layers - as many as hundreds of thousands of layers. Neural networks are designed to mimic the human brain. An example of these are convolution neural networks (CNNs) which are primarily used in computer vision and will be the focus of this course.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"JzYlXJPTJ1"}],"key":"WZvt8UjejD"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Some challenges of deep learning and neural networks are that they need lots of data and computing power. They are also often “black boxes” making them harder to understand and causing issues with transferring between use cases.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"PzKvTeqdwj"}],"key":"e6XG6xmtdy"},{"type":"heading","depth":4,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"What is Computer Vision (CV)?","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"lSl4qR6xMY"}],"identifier":"what-is-computer-vision-cv","label":"What is Computer Vision (CV)?","html_id":"what-is-computer-vision-cv","implicit":true,"key":"BJ3hGlwPN0"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Computer vision (CV) is a subfield of machine learning that focuses on machines being able to interpret visual data (images and video), such as identifying and classifying objects. There are traditional machine learning methods for computer vision such as support vector machine (SVM) and deep learning methods such as convolution neural networks (CNNs).","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"dVl5c7MW1e"}],"key":"fhcoBk5i5L"},{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Uses of AI in Marine Sciences","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"n9ME34FI0B"}],"identifier":"uses-of-ai-in-marine-sciences","label":"Uses of AI in Marine Sciences","html_id":"uses-of-ai-in-marine-sciences","implicit":true,"key":"Djy9qz5YQn"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"While AI in the form of computer vision is a powerful tool for processing marine imagery it is not the only field where AI is being used in the Marine Sciences. While not the focus of this course some examples of this include studying internal waves ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"XklKZnYvqK"},{"type":"cite","kind":"narrative","label":"Pan2018","identifier":"pan2018","error":"not found","key":"bfPg3ng5Qt"},{"type":"text","value":", ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"VbfQnSCsZB"},{"type":"cite","kind":"narrative","label":"Zheng2022","identifier":"zheng2022","error":"not found","key":"zaPEHLy3x3"},{"type":"text","value":", heatwaves ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"bRkI3hAmso"},{"type":"cite","kind":"narrative","label":"Jung2020","identifier":"jung2020","error":"not found","key":"NKs8uFmg3N"},{"type":"text","value":", ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"utFp8BdEF1"},{"type":"cite","kind":"narrative","label":"Asadollah2022","identifier":"asadollah2022","error":"not found","key":"o2Ltnd4vvc"},{"type":"text","value":", ENSO ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"hT9Qysc5Xd"},{"type":"cite","kind":"narrative","label":"Ham2019","identifier":"ham2019","error":"not found","key":"YZtj0QAyXf"},{"type":"text","value":", ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"A