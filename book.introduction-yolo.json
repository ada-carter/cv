{"version":3,"kind":"Notebook","sha256":"ffcb7a292df10d84274457f46ffca445687bdf90b7b3b67fe8ee60b42f5425e3","slug":"book.introduction-yolo","location":"/book/Introduction_YOLO.ipynb","dependencies":[],"frontmatter":{"title":"3.3 Training YOLO Models: A Guide to Understanding Tasks and Modes","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"Ada Carter & Katie Bigham","given":"Ada Carter & Katie","family":"Bigham"},"name":"Ada Carter & Katie Bigham","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/ada-carter/cv","copyright":"2025","numbering":{"title":{"offset":1}},"source_url":"https://github.com/ada-carter/cv/blob/main/book/Introduction_YOLO.ipynb","edit_url":"https://github.com/ada-carter/cv/edit/main/book/Introduction_YOLO.ipynb","thumbnail":"/build/7e2db436150c38a00650f96925aa5581.svg","exports":[{"format":"ipynb","filename":"Introduction_YOLO.ipynb","url":"/build/Introduction_YOLO-a79d5413802e097b1d600b1a02b92151.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"link","url":"https://colab.research.google.com/github/ada-carter/cv/blob/main/book/Introduction_YOLO.ipynb","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"image","url":"/build/7e2db436150c38a00650f96925aa5581.svg","alt":"Open In Colab","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jbditQiyYq","urlSource":"https://colab.research.google.com/assets/colab-badge.svg"}],"urlSource":"https://colab.research.google.com/github/ada-carter/cv/blob/main/book/Introduction_YOLO.ipynb","key":"TWf4JPBb2v"}],"key":"H0gl2W4e59"}],"key":"QW91ZsXxwI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Introduction to YOLO Models","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MLHxXJdIfK"}],"identifier":"introduction-to-yolo-models","label":"Introduction to YOLO Models","html_id":"introduction-to-yolo-models","implicit":true,"key":"s6nDIuVOIC"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"YOLO (You Only Look Once) models are incredibly versatile and can be applied to various tasks in computer vision, including detection, segmentation, classification, and pose estimation. These models can also handle oriented bounding boxes (OBB), which is particularly useful for specialized tasks like satellite or medical imagery. In marine science, YOLO models can help analyze underwater images and videos both in real time or after the fact, detecting and classifying marine organisms, shipwrecks, or plastic debris. Their ability to work on real-time video streams can also be leveraged in autonomous underwater vehicles (AUVs) for monitoring and exploration tasks. This efficiency is crucial in remote marine environments where computational resources are limited. A note about YOLO, as of now the only “Official” distributions of YOLO via Ultralytics are YOLOv5,v8 and now v11. Other distributions exist however they are often less open source and are usually very well tuned for a few large benchmark datasets but not large scale differences for our purposes. For this reason you may see YOLO imports be in any of the official distributions, I have done my best to choose the most stable and easiest to use version for each task, but the skills should be easily tranferable.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NJRgraK447"}],"key":"c1qI4w3viA"}],"key":"Yg3HR841yE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"YOLO Tasks","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qiHLBFKI05"}],"identifier":"yolo-tasks","label":"YOLO Tasks","html_id":"yolo-tasks","implicit":true,"key":"ZqQWk0SKyT"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"YOLO models can perform the following tasks:","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"BGzglVQE2n"}],"key":"XZoNPeOAtS"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Detect","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"y9wNqvQlDR"}],"key":"F6nZ7MUqiR"},{"type":"text","value":": Identify and localize objects in images or videos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FTBrQMm2pg"}],"key":"inEcUe6jZr"}],"key":"eHll0IsQja"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Segment","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"tvkeo3UIPw"}],"key":"WTEFw8mDgn"},{"type":"text","value":": Divide images or videos into regions corresponding to different objects.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"VG1Rvuw5BO"}],"key":"Tq6S51FDXT"}],"key":"brv36I0b46"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Classify","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"L86hbBwxEi"}],"key":"kRi30Ixboc"},{"type":"text","value":": Predict the class label of an image.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jJGc1jeTNk"}],"key":"LQfYYSQwMK"}],"key":"RAjL6gZqbM"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Pose","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"pAiS3iHupi"}],"key":"x6XUO5cJSd"},{"type":"text","value":": Estimate key points for objects in an image.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"pslWSWuE74"}],"key":"KxdIu74JQH"}],"key":"dyG4w4sw8f"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"OBB","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"gICZnEOx99"}],"key":"UjzQw9URfF"},{"type":"text","value":": Use oriented bounding boxes for specific imagery applications.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"zG4DnSCMfN"}],"key":"j8wP93PIjX"}],"key":"vfXEDC5HTF"}],"key":"w9JHxkenFm"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"In marine research, detection can be used to identify different fish species or coral structures in video footage, while segmentation could help distinguish between different types of habitats, such as coral reefs and sea grass beds. Classification tasks can assist in labeling different faunal species, and pose estimation can be useful when tracking movement patterns in marine animals. Oriented bounding boxes are valuable in aerial or satellite imagery analysis, where objects like ships or coastal structures need to be tracked in varying orientations.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"jDZVHC661m"}],"key":"Q8ttIns5Js"}],"key":"VbzbjN7iCr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"YOLO Modes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"isE7caBrCu"}],"identifier":"yolo-modes","label":"YOLO Modes","html_id":"yolo-modes","implicit":true,"key":"aI3ExVn11D"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The model can be used in different modes, depending on the objective:","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"vu6h4fSRRw"}],"key":"P63Av1FsWt"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Train","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"i4DQVZOQCc"}],"key":"y0HNVE4MtS"},{"type":"text","value":": Train a YOLO model on a custom dataset.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WCEZ62kGPS"}],"key":"IBBxeiUkc5"}],"key":"Pftin0uNIx"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Val","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Rf8LGMqcKn"}],"key":"Oz2pAviYMI"},{"type":"text","value":": Validate the model after training.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"i9NvmznDQ2"}],"key":"rvUbjmwDvE"}],"key":"khIXbzy1M4"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Predict","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"dJPwFSHWiS"}],"key":"N3g41vynG3"},{"type":"text","value":": Make predictions on new data.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Rfss8Uyrgl"}],"key":"OWFl27lUG3"}],"key":"SLTjihKy8A"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Export","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"YjzXQFg0m9"}],"key":"KqfrQUmUBA"},{"type":"text","value":": Export the model for deployment.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"CXX6VcMdhH"}],"key":"rOs3rs1c2u"}],"key":"TjIeOcgP2f"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Track","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"vOOLX9Mwd5"}],"key":"PZXr49i3Yz"},{"type":"text","value":": Track objects in real-time.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"wIPWwQybAf"}],"key":"jCDubLR2jp"}],"key":"zprJ1Qug95"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Benchmark","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"za0nb4LF02"}],"key":"zgMeNFj0Bq"},{"type":"text","value":": Evaluate model speed and accuracy after export.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"vNR2863Ow9"}],"key":"Uvxxs9Ep6u"}],"key":"nma9fAMHDH"}],"key":"GZwAh8nWym"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"In marine applications, training and validating a model is often done with custom datasets collected from ROVs or AUVs during underwater surveys. Prediction and tracking modes can be employed in live deployments to identify and monitor marine fauna in real-time, providing valuable data for fisheries management or ecological monitoring. Benchmarking can ensure that these models perform well in different environments, whether for deep-sea monitoring or coastal surveillance.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"V4NMixHskq"}],"key":"T9p4eJuffw"}],"key":"JxgJSnM5hj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Key Training Settings","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DH0tK6Fubq"}],"identifier":"key-training-settings","label":"Key Training Settings","html_id":"key-training-settings","implicit":true,"key":"nt81sMa5pn"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Training settings affect model performance, speed, and accuracy. Important settings include batch size, learning rate, image size, and device selection. For a complete understanding of each parameter, explore the official ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"JuaBUTB8ED"},{"type":"link","url":"https://docs.ultralytics.com/usage/cfg/#train-settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Train Settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Dbf2ECaPqX"}],"urlSource":"https://docs.ultralytics.com/usage/cfg/#train-settings","key":"cNvxT78XZJ"},{"type":"text","value":" on the Ultralytics documentation.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"L6s3b28nkg"}],"key":"FmNUG8arw6"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"In marine contexts, training settings must be carefully tuned due to the challenges posed by underwater environments, such as varying light conditions, occlusion, and the presence of marine snow. Optimizing batch sizes and learning rates helps ensure models are robust enough to handle these inconsistencies and perform accurately in diverse settings like coral reefs, hydrothermal vents, or the open ocean.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"CAzI3fzlSR"}],"key":"XDjSJoCs1j"}],"key":"R2UdYTR9hc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Inference Settings","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FbAQXJlDtl"}],"identifier":"inference-settings","label":"Inference Settings","html_id":"inference-settings","implicit":true,"key":"o0yvggiUC7"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Inference settings allow for model predictions on new data. Key parameters include confidence threshold, image size, and device. Adjusting these settings helps fine-tune the model’s predictions to your specific needs. Learn more in the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mHbmT9vAyY"},{"type":"link","url":"https://docs.ultralytics.com/usage/cfg/#predict-settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Predict Settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"vCeuymeeoC"}],"urlSource":"https://docs.ultralytics.com/usage/cfg/#predict-settings","key":"oWPe6nAEp2"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"JZmqfLgmW8"}],"key":"zX7LYm1Qgc"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"In marine research, inference is typically done after field surveys, where large datasets are processed to identify species or objects of interest. Adjusting inference settings can reduce false positives and ensure accurate detections of marine animals like whales or seals, especially when analyzing aerial or underwater images. For marine biologists, proper tuning of these settings can make the difference between accurate monitoring and misleading results.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"nG0HzmvwTd"}],"key":"yTEHCkmBXM"}],"key":"tTMxbzlAAH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Validation Settings","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Jc49zlV4bX"}],"identifier":"validation-settings","label":"Validation Settings","html_id":"validation-settings","implicit":true,"key":"RMfKddQWum"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The validation settings guide how to assess the model’s performance during training. You can explore these parameters in the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jO3Kt1aBt2"},{"type":"link","url":"https://docs.ultralytics.com/usage/cfg/#validation-settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Validation Settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"WcV0q5jqLv"}],"urlSource":"https://docs.ultralytics.com/usage/cfg/#validation-settings","key":"y73eJeWpJE"},{"type":"text","value":" section.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"zFc2lk8q8m"}],"key":"VxMf5Svyon"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Validation is critical when using models in marine science, as ocean environments are highly variable, and incorrect model validation can lead to false conclusions. For example, if you’re monitoring coral bleaching events, validation ensures that the model accurately differentiates between healthy and bleached coral, which directly impacts conservation efforts.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"o3mp1SB0mc"}],"key":"rmUaLpu2qx"}],"key":"xVPd818FUE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Export Settings","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q6ZlH0XFBC"}],"identifier":"export-settings","label":"Export Settings","html_id":"export-settings","implicit":true,"key":"YhRe6QNm1w"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Exporting a model for deployment involves adjusting settings like the target format (ONNX, TorchScript, etc.). Find detailed instructions in the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"j4z35rXsKn"},{"type":"link","url":"https://docs.ultralytics.com/usage/cfg/#export-settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Export Settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"cO7uHgX2PQ"}],"urlSource":"https://docs.ultralytics.com/usage/cfg/#export-settings","key":"jtRWcRZP6Q"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"MpDOe6de4c"}],"key":"fj0iI66e3f"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Exporting trained YOLO models in a marine context allows for their integration into field tools like AUVs or drones. By deploying models directly onto these devices, researchers can conduct in-situ analyses of underwater ecosystems, automatically identifying species or mapping features without needing constant human input. This is essential for remote, long-term monitoring projects.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"i8LYn0dIeR"}],"key":"NrZXbVRj20"}],"key":"y653dULAbS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Augmentation Settings","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QRSd8xK0ue"}],"identifier":"augmentation-settings","label":"Augmentation Settings","html_id":"augmentation-settings","implicit":true,"key":"jG7ewfFIxf"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Augmentation techniques introduce variability into training data to help the model generalize better. Learn how to apply these techniques in the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SJJDdy0Bkp"},{"type":"link","url":"https://docs.ultralytics.com/usage/cfg/#augmentation-settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Augmentation Settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"KBOuN7dZzB"}],"urlSource":"https://docs.ultralytics.com/usage/cfg/#augmentation-settings","key":"REqD4WIGeV"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"hsvukaaTBy"}],"key":"RrjWyy6JEk"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Marine environments are highly variable, with changes in water clarity, light, and object appearance. Augmentation techniques, like flipping or changing brightness, simulate these variations, allowing YOLO models to perform well under different conditions. For example, augmenting images of fish in low-light conditions can help the model generalize better when deployed in deep-sea environments.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Z2HzJoqxQ6"}],"key":"ImVVmRGRHb"}],"key":"v4CuFot1l6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Logging, Checkpoints, and Plotting Settings","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Sx9weMtqOW"}],"identifier":"logging-checkpoints-and-plotting-settings","label":"Logging, Checkpoints, and Plotting Settings","html_id":"logging-checkpoints-and-plotting-settings","implicit":true,"key":"KyZ2fueebl"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Proper logging, checkpointing, and plotting are crucial for tracking your model’s progress. Details on how to implement these are available in the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"v00v2sC9O2"},{"type":"link","url":"https://docs.ultralytics.com/usage/cfg/#logging-checkpoints-and-plotting-settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Logging, Checkpoints, and Plotting Settings","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jRt7gsPmA3"}],"urlSource":"https://docs.ultralytics.com/usage/cfg/#logging-checkpoints-and-plotting-settings","key":"qFLPEEREcu"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"y2ohQtTftY"}],"key":"wZFhhAJwbI"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"In marine research, monitoring the progress of your model during training is essential, especially when working with datasets collected in extreme conditions like the deep sea. Logging ensures that researchers can keep track of where models perform well or need improvement, while checkpointing allows training to resume if interrupted. Visual plots can help compare results across different environmental conditions, providing insights into model performance across multiple marine ecosystems.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"YMRHegI3RM"}],"key":"GionXwf7kF"}],"key":"QbCZd7xLj3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Next Steps","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DBK34jXVKR"}],"identifier":"next-steps","label":"Next Steps","html_id":"next-steps","implicit":true,"key":"xh2pUibEE6"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The next lessons will make heavy use of these parameters. It’s important to know them well to optimize training and inference performance. Bookmark the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"zpehLi0b6F"},{"type":"link","url":"https://docs.ultralytics.com/usage/cfg/","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Ultralytics YOLO documentation","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xjsB9uXffq"}],"urlSource":"https://docs.ultralytics.com/usage/cfg/","key":"cuvsCrPb92"},{"type":"text","value":" to stay updated on new features and default values.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NTh9ITye2T"}],"key":"KZ0q0rEUa2"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"In marine science, understanding these settings can significantly enhance your ability to build accurate, deployable models. Whether you’re studying marine life in shallow coastal areas or monitoring deep-sea ecosystems, mastery of these YOLO parameters ensures your model can handle the complexities of underwater environments.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Rppg205mdE"}],"key":"QuDgV8d1Ki"}],"key":"DxJkYFOfy8"}],"key":"mCuTbX3vRv"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"3.2 Image Classification with Keras","url":"/book/classification-keras","group":"Chapter 3 - Computer Vision Development"},"next":{"title":"3.4 Training and Deploying Object Detection with YOLO","url":"/book/trainanddeployobj-yolo","group":"Chapter 3 - Computer Vision Development"}}},"domain":"http://localhost:3000"}