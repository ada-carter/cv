26n.pt\n└── examples/           # Example images for testing\n    └── example1.jpg","position":{"start":{"line":34,"column":1},"end":{"line":42,"column":1}},"key":"HKDzeDjJkw"},{"type":"heading","depth":4,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Creating Requirements.txt","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"pEL5F3KMcK"}],"identifier":"creating-requirements-txt","label":"Creating Requirements.txt","html_id":"creating-requirements-txt","implicit":true,"key":"zdJ0clLoRE"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Create a ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"tuIpOmQNJU"},{"type":"inlineCode","value":"requirements.txt","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"SYr6wGgHIX"},{"type":"text","value":" file containing:","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"k6Q675g6P4"}],"key":"TIENGDn4NI"},{"type":"code","lang":"","value":"streamlit>=1.22.0\nultralytics>=8.0.0\nPillow>=9.0.0\nnumpy>=1.22.0","position":{"start":{"line":46,"column":1},"end":{"line":51,"column":1}},"key":"RYvzGqQELY"},{"type":"heading","depth":3,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Basic Inference App","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"Hi8ppxg5ms"}],"identifier":"basic-inference-app","label":"Basic Inference App","html_id":"basic-inference-app","implicit":true,"key":"InrTPLNkpI"},{"type":"code","lang":"python","value":"import streamlit as st\nfrom PIL import Image\nfrom ultralytics import YOLO\n\ndef main():\n    st.title(\"YOLO26 Object Detection App\")\n\n    # ...existing code for UI elements...\n    uploaded_file = st.file_uploader(\"Upload an image:\", type=[\"jpg\", \"jpeg\", \"png\"])\n    if uploaded_file is not None:\n        image = Image.open(uploaded_file)\n        st.image(image, caption=\"Uploaded Image\", use_column_width=True)\n        if st.button(\"Run Detection\"):\n            # Load a YOLO26 model (shows how to upload custom weights)\n            model = YOLO(\"yolo26n.pt\")  # Replace with your own weights if needed\n\n            # Run inference\n            results = model([image], stream=True)\n            for result in results:\n                # Show bounding boxes, masks, or other outputs in the console\n                st.write(\"Boxes:\", result.boxes)\n                if result.masks:\n                    st.write(\"Masks available\")\n                if result.keypoints:\n                    st.write(\"Keypoints available\")\n                if result.probs is not None:\n                    st.write(\"Classification probabilities:\", result.probs)\n                if result.obb is not None:\n                    st.write(\"Oriented bounding boxes:\", result.obb)\n\n                # Display results\n                result.show()\n                result.save(\"result.jpg\")  # Saves to disk\n                st.image(\"result.jpg\", caption=\"Inference Result\")\n\nif __name__ == \"__main__\":\n    main()","position":{"start":{"line":55,"column":1},"end":{"line":93,"column":1}},"key":"Np8LdLSjmi"},{"type":"heading","depth":3,"position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Advanced Streamlit Features","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"iKJpkyJQOU"}],"identifier":"advanced-streamlit-features","label":"Advanced Streamlit Features","html_id":"advanced-streamlit-features","implicit":true,"key":"sW1Xk3AhXj"},{"type":"heading","depth":4,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"Customizing the Sidebar","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"VMNKSlyQca"}],"identifier":"customizing-the-sidebar","label":"Customizing the Sidebar","html_id":"customizing-the-sidebar","implicit":true,"key":"ezUFb0MeSD"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"The sidebar provides a convenient place for controls and settings:","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"p5K6WYUndq"}],"key":"zxjiMwJvu4"},{"type":"code","lang":"python","value":"def sidebar_controls():\n    st.sidebar.title(\"Model Settings\")\n    \n    # Model selection\n    model_type = st.sidebar.selectbox(\n        \"Select Model Type\", \n        [\"YOLO26n\", \"YOLO26s\", \"YOLO26m\", \"YOLO26l\"]\n    )\n    \n    # Confidence threshold slider\n    conf_threshold = st.sidebar.slider(\n        \"Confidence Threshold\", \n        min_value=0.0, \n        max_value=1.0, \n        value=0.25, \n        step=0.05\n    )\n    \n    # IoU threshold slider\n    iou_threshold = st.sidebar.slider(\n        \"IoU Threshold\", \n        min_value=0.0, \n        max_value=1.0, \n        value=0.45, \n        step=0.05\n    )\n    \n    return model_type, conf_threshold, iou_threshold\n\n# In your main function:\nmodel_type, conf_threshold, iou_threshold = sidebar_controls()","position":{"start":{"line":101,"column":1},"end":{"line":133,"column":1}},"key":"uVav9YTH73"},{"type":"heading","depth":4,"position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"Handling Multiple Input Types","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"L0tXZ3qsuQ"}],"identifier":"handling-multiple-input-types","label":"Handling Multiple Input Types","html_id":"handling-multiple-input-types","implicit":true,"key":"fI633dPLlN"},{"type":"paragraph","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Allow users to input data in multiple ways:","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"BzweAITMFv"}],"key":"hs1uL1vHRm"},{"type":"code","lang":"python","value":"def get_input_data():\n    st.header(\"Input Options\")\n    \n    input_method = st.radio(\n        \"Select input method\",\n        [\"Upload Image\", \"Paste URL\", \"Use Webcam\"]\n    )\n    \n    image = None\n    \n    if input_method == \"Upload Image\":\n        uploaded_file = st.file_uploader(\"Upload an image\", type=[\"jpg\", \"jpeg\", \"png\"])\n        if uploaded_file is not None:\n            image = Image.open(uploaded_file)\n            \n    elif input_method == \"Paste URL\":\n        url = st.text_input(\"Enter image URL\")\n        if url and st.button(\"Fetch Image\"):\n            try:\n                import requests\n                from io import BytesIO\n                response = requests.get(url)\n                image = Image.open(BytesIO(response.content))\n            except Exception as e:\n                st.error(f\"Error fetching image: {e}\")\n                \n    elif input_method == \"Use Webcam\":\n        if st.button(\"Capture from Webcam\"):\n            picture = st.camera_input(\"Take a picture\")\n            if picture:\n                image = Image.open(picture)\n    \n    return image","position":{"start":{"line":139,"column":1},"end":{"line":173,"column":1}},"key":"b6GDZnMx7v"},{"type":"heading","depth":4,"position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"children":[{"type":"text","value":"Progress and Status Indicators","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"key":"I3efsl9px6"}],"identifier":"progress-and-status-indicators","label":"Progress and Status Indicators","html_id":"progress-and-status-indicators","implicit":true,"key":"pbilOtJvGL"},{"type":"paragraph","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"children":[{"type":"text","value":"Show progress during long operations:","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"pBmJ8XEqFd"}],"key":"x4KMSDIuhp"},{"type":"code","lang":"python","value":"def process_images(images):\n    # Create a progress bar\n    progress_bar = st.progress(0)\n    status_text = st.empty()\n    \n    results = []\n    for i, img in enumerate(images):\n        # Update progress\n        progress = (i + 1) / len(images)\n        progress_bar.progress(progress)\n        status_text.text(f\"Processing image {i+1}/{len(images)}\")\n        \n        # Process image\n        result = model(img)\n        results.append(result)\n        \n    status_text.text(\"Processing complete!\")\n    return results","position":{"start":{"line":179,"column":1},"end":{"line":198,"column":1}},"key":"OY7u4PNjN3"},{"type":"heading","depth":4,"position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"children":[{"type":"text","value":"Displaying Results with Tabs","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"key":"Q8jan9zVGt"}],"identifier":"displaying-results-with-tabs","label":"Displaying Results with Tabs","html_id":"displaying-results-with-tabs","implicit":true,"key":"sgJDdA71fO"},{"type":"paragraph","position":{"start":{"line":202,"column":1},"end":{"line":202,"column":1}},"children":[{"type":"text","value":"Organize results using tabs:","position":{"start":{"line":202,"column":1},"end":{"line":202,"column":1}},"key":"UuoFvrPQSV"}],"key":"FGUjmx5Fgv"},{"type":"code","lang":"python","value":"def display_results(results):\n    tab1, tab2, tab3 = st.tabs([\"Visualizations\", \"Statistics\", \"Raw Data\"])\n    \n    with tab1:\n        st.header(\"Detection Results\")\n        for i, result in enumerate(results):\n            st.subheader(f\"Image {i+1}\")\n            result.save(f\"result_{i}.jpg\")\n            st.image(f\"result_{i}.jpg\")\n    \n    with tab2:\n        st.header(\"Detection Statistics\")\n        for i, result in enumerate(results):\n            st.subheader(f\"Image {i+1}\")\n            # Count detections by class\n            boxes = result.boxes\n            if len(boxes) > 0:\n                labels = boxes.cls\n                unique_labels, counts = np.unique(labels.cpu().numpy(), return_counts=True)\n                st.write(\"Detected objects:\")\n                for label, count in zip(unique_labels, counts):\n                    st.write(f\"- {model.names[int(label)]}: {count}\")\n            else:\n                st.write(\"No objects detected\")\n    \n    with tab3:\n        st.header(\"Raw Detection Data\")\n        for i, result in enumerate(results):\n            st.subheader(f\"Image {i+1}\")\n            st.json(result.tojson())","position":{"start":{"line":204,"column":1},"end":{"line":235,"column":1}},"key":"tRCq0dg0qh"},{"type":"heading","depth":3,"position":{"start":{"line":237,"column":1},"end":{"line":237,"column":1}},"children":[{"type":"text","value":"Deploying to Streamlit Cloud","position":{"start":{"line":237,"column":1},"end":{"line":237,"column":1}},"key":"LfCHdm9rhE"}],"identifier":"deploying-to-streamlit-cloud","label":"Deploying to Streamlit Cloud","html_id":"deploying-to-streamlit-cloud","implicit":true,"key":"qNtSqXETvw"},{"type":"paragraph","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"text","value":"To deploy your app to ","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"key":"Bnd4BK2Vrh"},{"type":"link","url":"https://streamlit.io/cloud","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"children":[{"type":"text","value":"Streamlit Cloud","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1}},"key":"z0FEgyReXf"}],"urlSource":"https://streamlit.io/cloud","key":"sQdir2ayUs"},{"type":"text","value":":","position":{"start":{"line":239,"column":1},"end":{"line":239,"column":1